{
  "name": "@daban/engine",
  "private": true,
  "type": "module",
  "description": "Shared Node implementation with separate trusted agent and Linux executor entry graphs.",
  "engines": {
    "node": "^22.16.0 || >=24.0.0"
  },
  "dependencies": {
    "@daban/protocol": "0.1.4",
    "@modelcontextprotocol/client": "2.2.0",
    "drizzle-orm": "1.0.0-rc.5",
    "fflate": "0.8.3",
    "officeparser": "8.2.0",
    "playwright": "1.62.1",
    "quickjs-emscripten": "0.32.0",
    "selfsigned": "5.5.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.2.0",
    "drizzle-kit": "1.0.0-rc.5",
    "vitest": "5.0.5"
  },
  "version": "0.1.4",
  "scripts": {
    "build": "tsc -p tsconfig.json && node --experimental-strip-types ../../tools/engine.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json",
    "test": "npm run test:runtime --prefix ../.."
  },
  "exports": {
    "./archive": {
      "types": "./dist/archive.d.ts",
      "import": "./dist/archive.js"
    },
    "./component-files": {
      "types": "./dist/component-files.d.ts",
      "import": "./dist/component-files.js"
    },
    "./component": {
      "types": "./dist/component.d.ts",
      "import": "./dist/component.js"
    },
    "./payload": {
      "types": "./dist/payload.d.ts",
      "import": "./dist/payload.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js"
    },
    "./executor": {
      "types": "./dist/executor.d.ts",
      "import": "./dist/executor.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    },
    "./local-computer": {
      "types": "./dist/local-computer.d.ts",
      "import": "./dist/local-computer.js"
    },
    "./skill-package": {
      "types": "./dist/skill-package.d.ts",
      "import": "./dist/skill-package.js"
    }
  },
  "license": "AGPL-3.0-only"
}
