{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "daban-gallery",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../../dist-gallery/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/.well-known/*", "/healthz", "/readyz"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daban-gallery",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "PACKAGES", "bucket_name": "daban-gallery-packages" }],
  "vars": { "GALLERY_READ_MODE": "private", "GALLERY_MAX_PACKAGE_BYTES": "8388608" },
  "observability": { "enabled": true }
}
