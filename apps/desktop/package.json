{
  "name": "@daban/desktop",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "main": "../../dist-electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 5174 --strictPort",
    "build": "tsc -p tsconfig.json && vite build && vite build --config electron/vite.config.ts && vite build --config electron/vite.config.ts --mode preload",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. --config vitest.config.ts apps/desktop",
    "start": "electron ."
  },
  "dependencies": {
    "@daban/engine": "0.1.2",
    "@daban/protocol": "0.1.2",
    "@internationalized/date": "3.12.4",
    "builder-util-runtime": "9.7.0",
    "dompurify": "3.4.17",
    "electron-updater": "6.8.11",
    "katex": "0.19.1",
    "lowlight": "3.3.0",
    "lucide-react": "1.61.0",
    "mermaid": "12.2.0",
    "react": "19.3.1",
    "react-aria": "3.53.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/hast": "3.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "optionalDependencies": {
    "@computer-use/libnut-darwin": "2.7.1",
    "@computer-use/libnut-win32": "2.7.1"
  },
  "license": "AGPL-3.0-only"
}
